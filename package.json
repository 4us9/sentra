{
  "name": "sentra",
  "version": "0.4.0",
  "private": true,
  "description": "Sentra: a processor-agnostic firewall between AI agents and the money.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "start": "pnpm --filter @sentra/service start",
    "start:render": "node scripts/start-render.mjs",
    "demo": "pnpm --filter @sentra/service demo",
    "verify-ledger": "pnpm --filter @sentra/service verify-ledger"
  },
  "devDependencies": { "turbo": "^2.3.3", "typescript": "^5.7.2" }
}
