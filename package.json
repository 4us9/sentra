{
  "name": "sentra",
  "version": "0.2.0",
  "description": "Sentra — a runtime firewall between AI agents and PayPal. Inspects every agent payment before it executes and blocks the malicious ones.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./sdk/index.js",
    "./sdk": {
      "types": "./sdk/index.d.ts",
      "default": "./sdk/index.js"
    }
  },
  "types": "./sdk/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "demo": "node agent/demoAgent.js",
    "mcp": "node mcp/sentra-mcp.js",
    "verify-ledger": "node scripts/verify-ledger.js",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:adversarial": "node --test test/adversarial.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
