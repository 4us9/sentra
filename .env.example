# Copy to .env (cp .env.example .env). .env is gitignored; never commit it.
# With nothing set, every processor runs in clearly-labelled SIMULATED mode.

# --- PayPal: SANDBOX REST app (developer.paypal.com -> Apps & Credentials -> Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox only. Sentra refuses to start on any other PayPal base URL.
PAYPAL_BASE=https://api-m.sandbox.paypal.com

# --- Stripe: TEST mode secret key (dashboard.stripe.com/test/apikeys). Must start sk_test_ ---
# A live key is refused at startup.
STRIPE_SECRET_KEY=

# Which rail a mandate uses when it does not name one: paypal | stripe | external
SENTRA_PROCESSOR=paypal
# Set to "simulate" to force every rail into simulated mode even when keys are present.
SENTRA_PROCESSOR_MODE=

# --- Claude intent check (optional) ---
# Without a key, intent = hijack signatures + a vocabulary fallback (free, deterministic).
# With a key, each payment that passes the deterministic layers costs one short model call.
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-5-5 (fast, low cost).
ANTHROPIC_MODEL=
# Hard ceiling on model calls per hour, so a public demo cannot run up a bill.
SENTRA_LLM_HOURLY_CAP=120

# --- Hardening ---
# Key used to seal mandates. Auto-generated into data/secret.key if unset.
SENTRA_SECRET=
# If set, operator actions (issue mandate, approve, reinstate, reset) need header x-sentra-admin.
SENTRA_ADMIN_TOKEN=
# Rate limits (token buckets). /guard is per agent token; operator writes are per IP.
SENTRA_GUARD_BURST=60
SENTRA_GUARD_RPS=2
SENTRA_OPERATOR_BURST=40
SENTRA_OPERATOR_RPS=1
# Set to 1 behind a reverse proxy (Render, Fly, nginx) so limits see the real client IP.
SENTRA_TRUST_PROXY=

# --- Misc ---
# Policy files directory and the policy used when a mandate request names none.
SENTRA_POLICY_DIR=policies
SENTRA_DEFAULT_POLICY=grocery-run
# "off" silences the JSON decision log on stdout.
SENTRA_LOG=
PORT=3000
