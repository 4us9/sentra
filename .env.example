# --- PayPal SANDBOX REST app credentials (developer.paypal.com -> Apps & Credentials -> Sandbox) ---
# Without these Sentra still runs, in clearly-labelled SIMULATED mode (order ids start with SIM-).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox only. Sentra refuses to start on any other PayPal base URL.
PAYPAL_BASE=https://api-m.sandbox.paypal.com

# --- Optional: Claude intent check ---
# Without a key, intent = hijack signatures + a vocabulary fallback (free, deterministic).
# With a key, each payment that passes the deterministic layers costs one short model call.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. For the cheapest per-payment check set claude-haiku-5-5.
ANTHROPIC_MODEL=
# Hard ceiling on model calls per hour, so a public demo cannot run up a bill.
SENTRA_LLM_HOURLY_CAP=120

# --- Optional hardening ---
# Key used to seal mandates. Auto-generated into data/secret.key if unset.
SENTRA_SECRET=
# If set, operator actions (create mandate, approve, reinstate, reset) need header x-sentra-admin.
SENTRA_ADMIN_TOKEN=

PORT=3000
